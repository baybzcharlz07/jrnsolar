Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Redirect requested HTML URLs to their canonical clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(services|about|quote)\.html(?:[?\s]) [NC]
RewriteRule ^(services|about|quote)\.html$ /$1 [R=301,L]

# Serve the existing HTML files internally while keeping clean URLs.
RewriteRule ^(services|about|quote)/$ /$1 [R=301,L]
RewriteRule ^(services|about|quote)$ $1.html [L]
